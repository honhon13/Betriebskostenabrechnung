# ---------------------------------------------------------------------------
# Datenbank (Neon PostgreSQL)
# Die Neon-Integration von Vercel setzt beide Variablen automatisch.
# DATABASE_URL          = gepoolte Verbindung (App-Laufzeit)
# DATABASE_URL_UNPOOLED = direkte Verbindung (Migrationen, Seed)
# Auch hochgeladene Dokumente liegen in dieser Datenbank (Tabelle document_files).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# OCR – Azure Document Intelligence (optional)
# Endpoint und Key stehen im Azure-Portal an der Document-Intelligence-Ressource unter
# „Keys and Endpoint“. Sind beide gesetzt, wird jedes hochgeladene Dokument automatisch
# ausgelesen; ohne sie bleibt die OCR in der Oberfläche ausgeblendet.
# Die Zugangsdaten werden ausschließlich hier gelesen – nie in der Datenbank gespeichert.
# ---------------------------------------------------------------------------
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional – Standard: prebuilt-invoice bzw. 2024-11-30
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# ---------------------------------------------------------------------------
# Sitzungen
# ---------------------------------------------------------------------------
# SESSION_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Seed (nur für `npm run db:seed`)
# Ohne Angabe werden zufällige Initialpasswörter erzeugt und einmalig ausgegeben.
# ---------------------------------------------------------------------------
# SEED_PASSWORD_TOP1=
# SEED_PASSWORD_TOP2=
# SEED_PASSWORD_TOP3=
# SEED_SKIP_PASSWORD_CHANGE=false
